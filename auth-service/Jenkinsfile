pipeline {
    agent any

    stages {
        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Test') {
            steps {
                dir('auth-service') {
                    sh  """
                    ./mvnw test
                    """
                }
            }
        }

        stage('Package') {
            steps {
                dir('auth-service') {
                    sh """
                    ./mvnw package -DskipTests
                    """
                }
            }
        }

        stage('Build') {
            steps {
                dir('auth-service') {
                    sh """
                    docker build -t auth-service:${IMAGE_TAG} .
                    """
                }
            }
        }
    }
}
